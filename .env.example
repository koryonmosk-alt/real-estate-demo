# Copy to .env and fill values. Never commit .env.
# This template lists only the active Telegram demo and its Google/LLM dependencies.

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- Telegram demo bot ---
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_CHAT_ID=
TELEGRAM_LEADS_TAB=TelegramLeads
TELEGRAM_EVENTS_TAB=TelegramEvents
TELEGRAM_STATE_TAB=TelegramState
# Development-only: lets the owner account exercise prospect flows in a single-account test.
ALLOW_OWNER_AS_PROSPECT=false

# --- Google Sheets + Calendar (server-side service account) ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
LEAD_SHEET_ID=
LISTINGS_SHEET_ID=
OWNER_CALENDAR_ID=

